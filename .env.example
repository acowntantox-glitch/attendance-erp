# Copy this file to .env.local for local development. Never commit real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://attendance_erp:password@localhost:5432/attendance_erp"

# Random secret used to sign/derive session-related material. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Public base URL of the application (no trailing slash)
APP_URL="http://localhost:3000"

# development | test | production
NODE_ENV="development"

# --- Scheduled attendance processing (Batch 13 / 14) ---
# Vercel Cron sends this automatically as "Authorization: Bearer <CRON_SECRET>" when it is set as a
# Vercel project environment variable (>= 16 random characters). Required for the cron in vercel.json.
# CRON_SECRET="replace-with-a-random-string-of-at-least-16-characters"
# Secret for any other scheduler / manual calls to /api/internal/jobs/attendance-daily
# (>= 32 chars). With neither secret set the endpoint rejects every request.
# Generate with: openssl rand -base64 48
# INTERNAL_JOB_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
# Minutes after a work date ends (latest timezone / latest shift end) before it is processed. Default 180.
ATTENDANCE_PROCESSING_LAG_MINUTES="180"
# How many of the most recent eligible work dates each run examines. Default 7.
ATTENDANCE_PROCESSING_LOOKBACK_DAYS="7"

# --- Environment safety (Batch 14) ---
# Tests never read this file. Put your LOCAL test database URL in .env.test.local (git-ignored), e.g.
#   DATABASE_URL="postgresql://user:password@localhost:5432/attendance_erp_test"
# `pnpm test`, `pnpm db:seed` and `pnpm db:migrate` refuse any non-local database host. To deliberately
# allow one, set the matching variable to that EXACT hostname for that command only:
#   TEST_DATABASE_ALLOWED_HOST   a dedicated, non-production test database
#   SEED_ALLOW_REMOTE_HOST       a dedicated, non-production database to seed
#   MIGRATE_ALLOW_REMOTE_HOST    the database you intend to migrate (e.g. production, on purpose)
