# Safe placeholder values so environment validation never fails when running `pnpm test`
# without a local database configured. Tests that need a real PostgreSQL connection detect
# unreachability at runtime and skip themselves (see src/tests/setup/db.ts) — this file only
# needs to satisfy Zod's format checks, not point at a real server.
DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
SESSION_SECRET="test-session-secret-placeholder-value-not-for-real-use"
APP_URL="http://localhost:3000"
NODE_ENV="test"
